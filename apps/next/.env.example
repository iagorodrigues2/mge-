# Máquina de Vendas (Next.js) — copie para .env.local e preencha o que tiver.
# TUDO é opcional: sem nenhuma chave, o app roda em modo demonstração
# (Scout gera leads fictícios; WhatsApp devolve link wa.me; e-mail vira rascunho).

# --- Busca real de leads na internet (escolha UM) ---
# serper.dev (Google) — https://serper.dev
SERPER_API_KEY=""
# ou Brave Search API — https://brave.com/search/api
BRAVE_API_KEY=""

# --- WhatsApp Business Cloud API (envio automático real) ---
# Sem isto, a aprovação gera um link wa.me pronto (envio assistido).
WHATSAPP_BUSINESS_TOKEN=""
WHATSAPP_BUSINESS_PHONE_ID=""

# --- E-mail (SMTP) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
