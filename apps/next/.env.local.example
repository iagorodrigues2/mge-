# Copie para .env.local (o Next carrega automaticamente) e preencha.
# Sem nenhuma chave, o Scout usa o gerador fictício e o disparo vira rascunho.

# --- Banco de dados ---
# Sem DATABASE_URL: usa arquivo JSON local (só dev; NÃO funciona no Vercel).
# Com DATABASE_URL: usa Postgres. Use a connection string COM POOLER (Neon:
# host "-pooler"; Supabase: porta 6543) e sslmode=require.
DATABASE_URL=""

# --- Busca real de leads (Scout) — escolha UMA ---
# serper.dev (Google, tem cota grátis): cria conta → API Key
SERPER_API_KEY=""
# alternativa: Brave Search API
BRAVE_API_KEY=""

# --- Enriquecimento CNPJ: BrasilAPI é grátis e não precisa de chave ---

# --- Cérebro de IA (agente Vendedor) — o ÚNICO custo pago do stack ---
# Claude (recomendado): chave em console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=""
# Modelo: sonnet-5 (barato/rápido, ótimo p/ WhatsApp) ou opus-5 (máx. qualidade).
ANTHROPIC_MODEL="claude-sonnet-5"
# Plano B 100% gratuito (tier free, menor qualidade): Google Gemini.
# Só é usado quando NÃO há ANTHROPIC_API_KEY (a Claude tem prioridade).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
# Link de agendamento do Iago (opcional; usado pelo agente ao marcar reunião)
AGENDA_URL=""

# --- Envio real (opcional) ---
WHATSAPP_BUSINESS_TOKEN=""
WHATSAPP_BUSINESS_PHONE_ID=""
# SMTP p/ e-mail (nodemailer)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
