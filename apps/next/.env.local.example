# Copie para .env.local (o Next carrega automaticamente) e preencha.
# Sem nenhuma chave, o Scout usa o gerador fictício e o disparo vira rascunho.

# --- Banco de dados ---
# Sem DATABASE_URL: usa arquivo JSON local (só dev; NÃO funciona no Vercel).
# Com DATABASE_URL: usa Postgres. Use a connection string COM POOLER (Neon:
# host "-pooler"; Supabase: porta 6543) e sslmode=require.
DATABASE_URL=""

# --- Busca real de leads (Scout) — escolha UMA ---
# serper.dev (Google, tem cota grátis): cria conta → API Key
SERPER_API_KEY=""
# alternativa: Brave Search API
BRAVE_API_KEY=""

# --- Enriquecimento CNPJ: BrasilAPI é grátis e não precisa de chave ---

# --- Cérebro de IA (agente Vendedor) — o ÚNICO custo pago do stack ---
# Claude (recomendado): chave em console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=""
# Modelo: sonnet-5 (barato/rápido, ótimo p/ WhatsApp) ou opus-5 (máx. qualidade).
ANTHROPIC_MODEL="claude-sonnet-5"
# Plano B 100% gratuito (tier free, menor qualidade): Google Gemini.
# Só é usado quando NÃO há ANTHROPIC_API_KEY (a Claude tem prioridade).
GEMINI_API_KEY=""
# gemini-2.0-flash foi desligado pela Google em 01/06/2026 — use um Flash atual.
GEMINI_MODEL="gemini-2.5-flash"
# Link de agendamento do Iago (opcional; usado pelo agente ao marcar reunião)
AGENDA_URL=""

# --- Envio real (opcional) ---
WHATSAPP_BUSINESS_TOKEN=""
WHATSAPP_BUSINESS_PHONE_ID=""
# --- Agente Porteiro (avisa o Iago em handoff/dúvida pendente) ---
# E-mail: se vazio, cai no SMTP_USER abaixo.
IAGO_EMAIL=""
# WhatsApp PESSOAL do Iago (formato E.164, ex: 5541999999999) — diferente do
# número de teste do bot. Opcional: só manda se estiver preenchido, e é
# best-effort (pode falhar fora da janela de 24h da Meta); o e-mail continua
# sendo o canal garantido.
IAGO_WHATSAPP=""
# SMTP p/ e-mail (nodemailer)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# --- Login do painel (OBRIGATÓRIO em produção) ---
# Sem APP_SENHA ninguém entra no painel — nem você. O robô do WhatsApp segue
# funcionando (o webhook fica fora da parede). Mínimo 8 caracteres.
APP_SENHA=""
# Opcional: segredo separado para assinar o cookie. Sem ele, é derivado da
# senha — trocar a senha derruba as sessões abertas, que é o certo.
AUTH_SECRET=""
# Segredo do cron da Vercel. Sem ele a cadência automática NÃO roda (a rota
# fica fora do login, então é o que impede qualquer um de disparar follow-up).
CRON_SECRET=""

# --- Agenda (Google Calendar) — ver docs/agenda-google-calendar.md ---
GOOGLE_SA_EMAIL=""
GOOGLE_SA_PRIVATE_KEY=""
GOOGLE_CALENDAR_ID=""

# --- Instagram Direct (canal de ENTRADA) ---
# Conta Profissional vinculada a uma Página do Facebook. No Instagram não existe
# template: fora da janela de resposta não se manda nada, então o Rafael só
# atende quem chega — nunca sai atrás.
IG_PAGE_TOKEN=""   # token da Página (longo, não expira)
IG_USER_ID=""      # id da conta Instagram Business
IG_VERIFY_TOKEN="" # opcional: sem ele, reusa WHATSAPP_VERIFY_TOKEN
META_APP_SECRET="" # opcional: sem ele, reusa WHATSAPP_APP_SECRET
