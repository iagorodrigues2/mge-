# ============================================================================
# Marketplace Growth Engine — variáveis de ambiente
# Copie para .env e preencha. NUNCA commitar segredos reais.
# ============================================================================

# --- Banco de dados ---
# Dev local (Postgres nativo, sem custo): já configurado em packages/database/.env
# Produção: usar Neon ou Supabase (Vercel Marketplace)
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# --- Autenticação ---
NEXTAUTH_SECRET="troque-por-um-segredo-forte"
NEXTAUTH_URL="http://localhost:3000"

# --- Redis / filas (produção) ---
UPSTASH_REDIS_URL=""
UPSTASH_REDIS_TOKEN=""

# --- Storage de evidências/anexos (produção) ---
BLOB_READ_WRITE_TOKEN=""

# --- Enriquecimento CNPJ (fonte pública gratuita) ---
BRASILAPI_BASE_URL="https://brasilapi.com.br/api"

# --- WhatsApp Business API (Modo 2 — Oficial, opcional, requer aprovação Meta) ---
WHATSAPP_BUSINESS_TOKEN=""
WHATSAPP_BUSINESS_PHONE_ID=""

# --- Google Calendar (opcional) ---
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""

# --- Provedor de pagamentos (evolução, MVP é registro manual) ---
PAYMENT_PROVIDER_API_KEY=""

TZ="America/Sao_Paulo"
